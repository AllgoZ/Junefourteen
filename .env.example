# Copy to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role-equivalent key (new Supabase API key system). Server-only — never expose to the browser.
SUPABASE_SECRET_KEY=

# Legacy JWT signing secret — only needed if you're manually verifying JWTs outside the Supabase SDK.
SUPABASE_JWT_SECRET=

# Postgres connection string, used only by scripts under supabase/scripts (migrations, seed, admin bootstrap).
# Use the session pooler URL (postgres.<ref>@aws-0-<region>.pooler.supabase.com:5432), not the direct db.<ref>.supabase.co
# host — the latter is IPv6-only and unreachable from many networks/CI runners.
SUPABASE_DB_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (test-mode key ids are prefixed rzp_test_, live ones rzp_live_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set in the Razorpay Dashboard under Settings > Webhooks when configuring
# the endpoint at /api/webhooks/razorpay (subscribe to payment.captured and
# order.paid). Distinct from RAZORPAY_KEY_SECRET — signs the raw webhook
# body, not the Checkout callback.
RAZORPAY_WEBHOOK_SECRET=

# Meta (Facebook) Pixel ID for storefront conversion tracking (PageView).
# Not a secret — ships to the browser, hence NEXT_PUBLIC_. Leave blank to
# disable the pixel entirely: the storefront renders no tracking code when
# unset. Admin routes never load it (separate root layout). See ARCHITECTURE.md §23.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 measurement ID for the storefront (gtag.js), e.g.
# G-XXXXXXXXXX. Not a secret — ships to the browser. Leave blank to disable:
# the storefront renders no analytics code when unset. Admin routes never
# load it. See ARCHITECTURE.md §23.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend (transactional email) — server-only. See ARCHITECTURE.md §24.
RESEND_API_KEY=

# Optional — "Display Name <address@yourdomain>". Falls back to Resend's
# unverified-domain sandbox sender if unset, which cannot reliably deliver to
# arbitrary recipients — set this once a sending domain is verified in the
# Resend dashboard.
RESEND_FROM_EMAIL=

# Used only to build links back to the site inside transactional emails
# (order/tracking links). Not a secret. Defaults to https://www.junefourteen.in
# if unset.
NEXT_PUBLIC_SITE_URL=
